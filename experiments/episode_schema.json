{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telescope pointing episode",
  "type": "object",
  "required": [
    "episode_id", "timestamp_utc", "substrate", "controller", "target",
    "commanded_ra_deg", "commanded_dec_deg", "verified_ra_deg", "verified_dec_deg",
    "pointing_error_arcmin", "latency_ms", "n_stars", "energy_wh"
  ],
  "properties": {
    "episode_id": { "type": "string", "pattern": "^[A-Z0-9]{2,4}-[0-9]{3,5}$" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "substrate": { "enum": ["E1_cpu", "E2_hailo8l", "E3_cloud"] },
    "controller": { "enum": ["pid", "mpc"] },
    "target": {
      "type": "object",
      "required": ["name", "ra_deg", "dec_deg"],
      "properties": {
        "name": { "type": "string" },
        "ra_deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "dec_deg": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "commanded_ra_deg": { "type": "number" },
    "commanded_dec_deg": { "type": "number" },
    "verified_ra_deg": { "type": "number" },
    "verified_dec_deg": { "type": "number" },
    "pointing_error_arcmin": { "type": "number", "minimum": 0 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "n_stars": { "type": "integer", "minimum": 0 },
    "energy_wh": { "type": "number", "minimum": 0 },
    "seeing_fwhm_arcsec": { "type": "number", "minimum": 0 },
    "ambient_c": { "type": "number" },
    "network": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["fibre", "mobile", "none"] },
        "rtt_ms": { "type": "number", "minimum": 0 },
        "cold_start": { "type": "boolean" }
      }
    },
    "valid": { "type": "boolean", "default": true },
    "invalid_reason": { "type": "string" }
  },
  "additionalProperties": false
}
