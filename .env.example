# Copy to .env and fill in, or let scripts/deploy.sh generate it.
# Every value below is required: docker-compose fails closed if one is missing.

TELESCOPE_API_TOKEN=

# Two MQTT identities: the broker's ACLs give them different powers.
#   pi    — publishes state, reads commands
#   phone — reads state, writes commands
MQTT_PI_USER=pi
MQTT_PI_PASSWORD=
MQTT_PHONE_USER=phone
MQTT_PHONE_PASSWORD=

INFLUX_USER=telescope
INFLUX_PASSWORD=
INFLUX_TOKEN=
GRAFANA_PASSWORD=
